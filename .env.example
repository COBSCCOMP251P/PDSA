# ============================================
# PDSA Games Environment Configuration
# ============================================
# INSTRUCTIONS:
# 1. Copy this file and rename to .env
# 2. Update the values below to match YOUR system
# 3. Never commit .env to Git (it contains passwords)
# ============================================

# Database Configuration (REQUIRED - Update these!)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

# API Configuration (Usually no changes needed)
API_HOST=127.0.0.1
API_PORT=8000

# Development Settings
DEBUG=true
