# Eight Queens Game - Database Environment Configuration
# Copy this file to .env and update with your MySQL database credentials

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# MySQL Server Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eight_queens_game
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Connection Pool Settings
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Flask/FastAPI Settings
SECRET_KEY=your_secret_key_here
DEBUG=True

# Session Configuration
SESSION_TIMEOUT=3600

# ==============================================
# PERFORMANCE MONITORING
# ==============================================

# Enable performance logging
ENABLE_PERFORMANCE_LOGGING=True
LOG_LEVEL=INFO

# Database query timeout (seconds)
DB_TIMEOUT=30

# ==============================================
# SECURITY SETTINGS
# ==============================================

# Password hashing (if implementing user authentication)
PASSWORD_SALT=your_salt_here

# CORS settings for frontend
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==============================================
# GAME CONFIGURATION
# ==============================================

# Maximum solutions to find before reset
MAX_SOLUTIONS=92

# Default algorithm type
DEFAULT_ALGORITHM=sequential

# Threading configuration
MAX_THREADS=4
DEFAULT_THREADS=4