# Environment Configuration for Tower of Hanoi Game
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password_here
DATABASE_NAME=pdsa_games

# API Configuration
PORT=8000
DEBUG=true

# Security (for production)
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (for production, be more restrictive)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tower_hanoi.log

# Performance Settings
MAX_WORKERS=4
ALGORITHM_TIMEOUT=30